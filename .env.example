# BingX API Credentials
BINGX_API_KEY=your_bingx_api_key_here
BINGX_SECRET_KEY=your_bingx_secret_key_here

# --- LLM Configurations (OpenAI Compatible) ---

# Fallback Option 1: Moonshot AI (Kimi)
# API Documentation: https://platform.moonshot.cn/docs/
MOONSHOT_API_KEY=your_moonshot_api_key_here
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_MODEL=moonshot-v1-8k

# Fallback Option 2: Mimo-v2 (Xiaomi)
# API Documentation: https://xiaomimimo.com/
MIMO_API_KEY=your_mimo_api_key_here
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5-pro

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Database Configuration
DB_NAME=trading_db
DB_USER=postgres
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=5432

# Trading Configuration
TRADING_MODE=paper # paper or live
BANKROLL=1000
MAX_RISK_PER_TRADE=0.02
MAX_LEVERAGE=5.0
CHECK_INTERVAL=60
